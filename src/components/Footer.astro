---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
const year = new Date().getFullYear();
const servicePages = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<footer class="border-t border-line bg-bg-2 pt-12 pb-28 text-sm text-muted lg:pb-12">
  <div class="mx-auto grid max-w-site gap-8 px-5 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="mb-2 text-base font-bold text-text">{site.name}</p>
      <p>מנעולן מוסמך ומתקין מורשה elock. שירות בכל אזור {site.region}.</p>
      <p class="mt-3"><a class="text-lg font-bold text-gold-light" href={site.phoneHref} dir="ltr">{site.phoneDisplay}</a></p>
    </div>
    <nav aria-label="שירותים">
      <p class="mb-2 font-bold text-text">שירותים</p>
      <ul class="grid gap-1.5">
        {servicePages.map((p) => <li><a class="hover:text-gold-light" href={`/services/${p.id}/`}>{p.data.title}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="מידע">
      <p class="mb-2 font-bold text-text">מידע</p>
      <ul class="grid gap-1.5">
        <li><a class="hover:text-gold-light" href="/#areas">אזורי שירות</a></li>
        <li><a class="hover:text-gold-light" href="/#faq">שאלות נפוצות</a></li>
        <li><a class="hover:text-gold-light" href="/#contact">צור קשר</a></li>
        <li><a class="hover:text-gold-light" href="/accessibility/">הצהרת נגישות</a></li>
        <li><a class="hover:text-gold-light" href="/privacy/">מדיניות פרטיות</a></li>
      </ul>
    </nav>
  </div>
  <p class="mx-auto mt-10 max-w-site px-5">© {year} {site.name}</p>
</footer>
