---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-line pt-10 pb-28 text-sm text-muted lg:pb-10">
  <div class="mx-auto flex max-w-site flex-wrap justify-between gap-5 px-5">
    <p>© {year} {site.name} · מנעולן מוסמך · <a class="hover:text-gold-light" href={site.phoneHref} dir="ltr">{site.phoneDisplay}</a></p>
    <p>שירות בכל אזור {site.region}</p>
  </div>
</footer>
