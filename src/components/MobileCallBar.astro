---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<div class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 gap-2.5 border-t border-line bg-bg/95 px-3 pt-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] lg:hidden">
  <a class="btn btn-gold py-3" href={site.phoneHref}><Icon name="phone" class="size-5.5" />התקשרו</a>
  <a class="btn btn-wa py-3" href={site.whatsappHref} rel="noopener"><Icon name="whatsapp" class="size-5.5" />וואטסאפ</a>
</div>
