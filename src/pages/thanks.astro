---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButtons from '../components/CtaButtons.astro';
---
<BaseLayout title="תודה, הפנייה התקבלה | M.O שירותי מנעולנות" description="הפנייה התקבלה. נחזור אליכם בהקדם." noindex>
  <section class="mx-auto max-w-site px-5 py-24 text-center">
    <h1 class="mb-4 text-section font-black text-gold">תודה, הפנייה התקבלה</h1>
    <p class="mb-8 text-lg text-muted">נחזור אליכם בהקדם. אם זה דחוף, הכי מהיר להתקשר או לשלוח וואטסאפ.</p>
    <CtaButtons class="justify-center" />
  </section>
</BaseLayout>
